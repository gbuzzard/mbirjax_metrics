# torch_run_configs.env — the run-time knobs for the MBIRTORCH nightly regression, kept at the top
# level so they are easy to find and edit.  The torch harness sources this (via
# tooling/regression/torch_regression.env); because each run pulls the metrics repo before
# measuring, edits here propagate automatically.  Sibling of run_configs.env (the jax knobs) —
# the two files are independent so a torch edit can never perturb the jax nightly.

# mbirtorch branches to track (FIRE-ON-CHANGE): each is measured only when its remote tip moves.
# `main` alone to start: it activates the dashboard's vs-main correctness reference (the analyzer
# tests the branch name literally), and a second tracked branch doubles the worst-night GPU cost.
# `greg_dev` is the natural second once the series is established.  Do NOT track `master` — it is
# behind `main`, and its old results were removed as incomparable (nightly_plan.md §9).
TORCH_TRACKED_BRANCHES=("main")

# ── torch CUDA-build selection ────────────────────────────────────────────────────────────────
# torch selects its CUDA build through the WHEEL INDEX, not through a pip extra (unlike jax, where
# jax[cuda13] pins the plugin).  mbirtorch's pyproject declares `torch>=2.13` with no CUDA extra,
# so a plain `pip install -e .[test]` resolves whatever the default index serves.  The GPU install
# therefore pre-installs torch from this index (cu130 to match the existing 2.13.0+cu130 build),
# then the editable install finds torch satisfied.
#
# KEEP IN SYNC WITH THE CUDA MODULE THE NODE LOADS (PREAMBLE_FILE -> `module load cuda`).
# A mismatch does not fail loudly at install time; the writer's platform guard aborts the RUN when
# torch.cuda cannot initialise (the 2026-07-21 jax lesson, applied to torch), so the symptom of a
# stale index here is an aborted gpu-torch night, not silently-wrong data.
TORCH_INDEX_URL_gpu="https://download.pytorch.org/whl/cu130"
TORCH_INDEX_URL_cpu=""            # empty = default PyPI index (macOS arm64 wheels live there)

# pip extras for the editable install of each measured branch (mbirtorch pyproject: test = pytest,
# pytest-xdist).  No CUDA extra exists for torch — see TORCH_INDEX_URL above.
TORCH_INSTALL_EXTRAS="test"

# Python version for the dedicated mbirtorch_regression conda env, used only if the harness must
# create that env.
TORCH_CONDA_PYTHON="3.12"

# ── Gate knobs ────────────────────────────────────────────────────────────────────────────────
# TORCH_MEM_GATE_WINDOW: rolling-MIN window (runs) for the gpu-torch memory gate.  The jax default
# of 3 exists for a JAX artefact: its sharded-path peak_bytes_in_use is bimodal per run.  torch
# reads max_memory_allocated — a different instrument — and the trial run's repeat ablation
# (nightly_plan.md §3(c-ii): one cell, five fresh subprocesses) decides this number from data.
# 1 = single-shot compare, no detection lag; a bimodal measured spread would justify 3, as on jax.
# PROVISIONAL until the trial-run ablation is recorded here.
TORCH_MEM_GATE_WINDOW=1

# Device counts each nightly row measures.  "1" until the n>1 increment (nightly_plan.md §7,
# increment 7) raises the allocation and adds the reduced n∈{2,4} cell set.
TORCH_DEVICE_COUNTS="1"

# ── macOS scheduling — the local time-of-day the Mac runs the cpu-torch nightly (launchd path).
# Same dark-wake caveat as the jax nightly: pick a time the Mac is normally AWAKE.  Staggered an
# hour after the jax Mac run (09:00) so the two never contend for the machine.
TORCH_MACOS_NIGHTLY_TIME="10:00"

# ── Cluster (SLURM) scheduling — used by enable_torch_nightly.sh (scrontab) and
# nightly_torch_regression.slurm.  ONE GPU: the n=1 sweep needs no more, and the jax nightly's
# 4-GPU request would charge this job 4x for no benefit (the n>1 increment raises this together
# with TORCH_DEVICE_COUNTS).  ai partition: 14 cores per GPU is the required ratio; never pass
# --mem there (host RAM is fixed at ~126 GB per GPU).
TORCH_SLURM_ACCOUNT="bouman"
TORCH_SLURM_PARTITION="ai"
TORCH_SLURM_QOS="normal"
TORCH_SLURM_GPUS_PER_NODE=1
TORCH_SLURM_NTASKS=14
# Ceiling for a changed-branch night.  The nightly_plan.md §3(a) estimate is ~30 min of
# measurement plus 5-10 min of suite on one H100; 2 h is a ~3x margin, and fire-on-change exits
# in seconds on a no-change night.  The trial run replaces the estimate with a measured wall
# time — update this comment with that number.
TORCH_SLURM_WALLTIME="02:00:00"
